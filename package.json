{
  "name": "cloudcart",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/generate-seo.mjs && node scripts/audit-seo.mjs && node scripts/validate-schema.mjs",
    "preview": "node scripts/preview-production.mjs",
    "check:seo": "node scripts/audit-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:lighthouse": "node scripts/lighthouse-audit.mjs",
    "check:schema": "node scripts/validate-schema.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.12.1",
    "lighthouse": "^13.6.0",
    "parse5": "^8.1.1",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
